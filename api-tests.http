# Tic-Tac Store — API Tests
# Requiere la extensión "REST Client" de VS Code (humao.rest-client)
#
# Uso:
#   1. Cambia @baseUrl si corrés en otro puerto
#   2. Ejecutá "### Register" primero para obtener un token
#   3. Pegá el token devuelto en @token
#   4. Ya podés correr los demás requests autenticados

@baseUrl = http://localhost:8000/api
@token = 3|Q74H4CPOQRhQlLGCHEM6LEZZ6xhAOLhmGybSoENJ6ebd3418

###############################################################################
# AUTH
###############################################################################

### Register — Crear cuenta nueva
# @name register
POST {{baseUrl}}/register
Content-Type: application/json

{
  "name": "Juan Test",
  "email": "juan@test.com",
  "password": "password123",
  "password_confirmation": "password123"
}

###

### Login — Iniciar sesión
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "juan@test.com",
  "password": "password123"
}

###

### Usuario autenticado
GET {{baseUrl}}/user
Authorization: Bearer {{token}}

###

### Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{token}}

###############################################################################
# PRODUCTOS
###############################################################################

### Listar todos los productos (paginado)
GET {{baseUrl}}/products

###

### Listar productos con filtros
GET {{baseUrl}}/products?search=casio&in_stock=true&max_price=100000

###

### Filtrar por marca
GET {{baseUrl}}/products?brand=Seiko

###

### Detalle de un producto (cambiar el ID)
GET {{baseUrl}}/products/1

###############################################################################
# PEDIDOS
###############################################################################

### Crear un pedido
# Ajustá los product_id con IDs reales de tu base de datos
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "customer_name": "Juan Test",
  "customer_email": "juan@test.com",
  "customer_phone": "3814001234",
  "shipping_address": "Av. Siempreviva 742, Tucumán",
  "notes": "Dejar en portería",
  "items": [
    { "product_id": 1, "quantity": 1 }
  ]
}

###

### Mis pedidos
GET {{baseUrl}}/orders
Authorization: Bearer {{token}}

###

### Detalle de un pedido (cambiar el ID)
GET {{baseUrl}}/orders/1
Authorization: Bearer {{token}}

###############################################################################
# ERRORES ESPERADOS (para verificar validaciones)
###############################################################################

### Login con credenciales incorrectas → 422
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "noexiste@mail.com",
  "password": "wrong"
}

###

### Crear pedido sin token → 401
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer_name": "Anon",
  "customer_email": "anon@mail.com",
  "shipping_address": "Sin dirección",
  "items": [{ "product_id": 1, "quantity": 1 }]
}

###

### Crear pedido con stock insuficiente → 422
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "customer_name": "Juan Test",
  "customer_email": "juan@test.com",
  "shipping_address": "Av. Test 123",
  "items": [{ "product_id": 1, "quantity": 99999 }]
}

###############################################################################
# GESTIÓN DE PRODUCTOS (Admin/Vendedor)
###############################################################################

### Crear producto
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Nuevo Reloj Casio Vintage",
  "description": "Edición retro metálica dorada",
  "price": 75000.00,
  "stock": 15,
  "brand": "Casio",
  "image_url": "https://example.com/vintage.jpg"
}

###

### Actualizar producto (cambiar el ID)
PUT {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Casio G-Shock Modificado",
  "description": "Descripción actualizada",
  "price": 50000.00,
  "stock": 10,
  "brand": "Casio",
  "image_url": "https://example.com/gshock.jpg"
}

###

### Eliminar producto (cambiar el ID)
DELETE {{baseUrl}}/products/1
Authorization: Bearer {{token}}

###############################################################################
# GESTIÓN DE PEDIDOS GLOBAL (Admin/Vendedor)
###############################################################################

### Listar todos los pedidos globalmente
GET {{baseUrl}}/admin/orders
Authorization: Bearer {{token}}

###

### Listar pedidos globales con filtros
GET {{baseUrl}}/admin/orders?status=pending&search=Juan
Authorization: Bearer {{token}}

###

### Detalle de cualquier pedido
GET {{baseUrl}}/admin/orders/1
Authorization: Bearer {{token}}

###

### Actualizar estado de un pedido
PATCH {{baseUrl}}/admin/orders/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "processing"
}

###############################################################################
# GESTIÓN DE VENDEDORES (Sólo Administrador)
###############################################################################

### Listar vendedores pendientes
GET {{baseUrl}}/admin/users?status=pending
Authorization: Bearer {{token}}

###

### Listar todos los vendedores
GET {{baseUrl}}/admin/users?status=all
Authorization: Bearer {{token}}

###

### Aprobar vendedor (cambiar el ID de usuario)
PATCH {{baseUrl}}/admin/users/2/approve
Authorization: Bearer {{token}}

###

### Rechazar vendedor (cambiar el ID de usuario)
PATCH {{baseUrl}}/admin/users/2/reject
Authorization: Bearer {{token}}

###

### Eliminar vendedor (cambiar el ID de usuario)
DELETE {{baseUrl}}/admin/users/2
Authorization: Bearer {{token}}

###############################################################################
# ERRORES DE AUTENTICACIÓN Y ESTADO
###############################################################################

### Login de usuario con cuenta en estado PENDING (debe fallar)
# Para probar: registrá un mail nuevo primero, y luego intentá loguearte
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "nuevo_vendedor_pendiente@test.com",
  "password": "password123"
}

###

### Petición a ruta Admin con token de rol Vendedor (debe dar 403)
# Probá esta petición con el token de un vendedor aprobado (no admin)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}
