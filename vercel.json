{
    "version": 2,
    "env": {
        "APP_NAME": "eCommerce",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://e-commerse-pazos-vedoya.vercel.app",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "local",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "ep-sparkling-forest-aclc8rhl.sa-east-1.aws.neon.tech",
        "DB_PORT": "5432",
        "DB_DATABASE": "neondb",
        "DB_USERNAME": "neondb_owner",
        "DB_PASSWORD": "npg_SOg7iMlZDr8I",
        "DB_SSLMODE": "require"
    },
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 30,
            "memory": 2048
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "outputDirectory": "public"
}